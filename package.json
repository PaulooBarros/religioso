{
  "name": "estudio-teologico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "bible:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-bible.mts",
